{
  "schema": 1,
  "product": "CIZHENYU OpenCode",
  "repo": "https://github.com/youcizi-art/cizhenyu_opencode_agent.git",
  "strategy": "B",
  "release": {
    "version": "0.1.3",
    "channel": "stable",
    "notes": "预装社区插件市场 awesome-opencode-market；打开项目自动确保 session"
  },
  "market": {
    "npmPackage": "awesome-opencode-market",
    "npmVersion": "0.1.0",
    "install": "local-path-plugin",
    "catalog": "https://awesome-market.github.io/awesome-opencode-market/",
    "repo": "https://github.com/awesome-market/awesome-opencode-market",
    "note": "Plan A: Deploy npm-packs into home/config/opencode/plugins and enables via opencode.json (opencode plugin add hangs on cold npm cache)"
  },
  "install": {
    "target": "{systemRoot}/agents/opencode_agent",
    "fetch": "github-zip",
    "owner": "youcizi-art",
    "name": "cizhenyu_opencode_agent",
    "branch": "master",
    "post": [
      "npm install"
    ],
    "preserve": [
      "home",
      "node_modules"
    ]
  },
  "kernel": {
    "kind": "opencode-cli",
    "npmPackage": "@opencode/cli",
    "npmVersion": "latest",
    "note": "Official OpenCode CLI embeds Web UI; Deploy runs `opencode serve` and opens WebView"
  },
  "runtime": {
    "xdgConfigHomeEnv": "XDG_CONFIG_HOME",
    "xdgCacheHomeEnv": "XDG_CACHE_HOME",
    "passwordEnv": "OPENCODE_PASSWORD",
    "passwordFileRelative": "home/.cizhenyu-opencode-password",
    "homeRelative": "home",
    "configRelative": "home/config",
    "cacheRelative": "home/cache",
    "opencodeConfigRelative": "home/config/opencode/opencode.json",
    "serve": {
      "defaultPort": 13990,
      "openScript": "deploy/open-web.mjs",
      "ui": "webview-pair-connect"
    },
    "customerEntry": "web",
    "debugEntry": "cli"
  }
}
